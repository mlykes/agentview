#!/bin/sh
# agentview launcher -- runs straight from a checkout, no install.
#
# Symlink it onto your PATH:
#   ln -s "$PWD/bin/agentview" ~/.local/bin/agentview
#
# It resolves its own location (following symlinks) to find the repo, so it works
# from any working directory. Set AGENTVIEW_PYTHON to choose an interpreter.
set -e

target="$0"
while [ -L "$target" ]; do
    dir=$(cd -P "$(dirname "$target")" && pwd)
    target=$(readlink "$target")
    case "$target" in
        /*) ;;
        *) target="$dir/$target" ;;
    esac
done
root=$(cd -P "$(dirname "$target")/.." && pwd)

exec env PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" \
    "${AGENTVIEW_PYTHON:-python3}" -m agentview "$@"
